{
  "name": "ai4u",
  "displayName": "AI4U",
  "description": "AI4U - Your personal AI assistant in VS Code",
  "version": "0.0.2",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai4u.openChat",
        "title": "Open AI4U Chat",
        "category": "AI4U"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai4uChatContainer",
          "title": "AI4U",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "ai4uChatContainer": [
        {
          "id": "ai4uChatView",
          "name": "AI4U Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "AI4U",
      "properties": {
        "ai4u.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Backend server URL for AI4U (e.g., http://your-ec2-instance.com:8000)"
        },
        "ai4u.useBackend": {
          "type": "boolean",
          "default": false,
          "description": "Use backend server instead of local OpenAI API calls"
        },
        "ai4u.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Request timeout in milliseconds"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@types/node-fetch": "^2.6.2",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "openai": "^4.0.0",
    "node-fetch": "^2.6.7"
  }
}
