{
  "name": "ai4u",
  "displayName": "AI4U",
  "description": "AI4U - Your personal AI assistant in VS Code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["Other"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai4u.openChat",
        "title": "Open AI4U Chat",
        "category": "AI4U"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai4uChatContainer",
          "title": "AI4U",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "ai4uChatContainer": [
        {
          "id": "ai4uChatView",
          "name": "AI4U Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "AI4U",
      "properties": {
        "ai4u.openaiApiKey": {
          "type": "string",
          "default": "",
          "description": "OpenAI API Key for AI4U"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "openai": "^4.0.0"
  }
}