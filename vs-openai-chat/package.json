{
  "name": "ai4u",
  "displayName": "AI4U",
  "publisher": "Anil Kumar Gupta",
  "description": "AI4U - Your personal AI assistant with Learning Gates in VS Code",
  "version": "0.0.3",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": ["AI", "Chat", "Education"],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "ai4u.openChat",
        "title": "Open AI4U Chat",
        "category": "AI4U"
      },
      {
        "command": "ai4u.checkStatus",
        "title": "Check AI4U Status",
        "category": "AI4U"
      },
      {
        "command": "ai4u.toggleBackend",
        "title": "Toggle Backend/Local Mode",
        "category": "AI4U"
      },
      {
        "command": "ai4u.toggleLearningGates",
        "title": "Toggle Learning Gates",
        "category": "AI4U"
      },
      {
        "command": "ai4u.viewProgress",
        "title": "View Learning Progress",
        "category": "AI4U"
      },
      {
        "command": "ai4u.resetProgress",
        "title": "Reset Learning Progress",
        "category": "AI4U"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "ai4uChatContainer",
          "title": "AI4U",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "ai4uChatContainer": [
        {
          "id": "ai4uChatView",
          "name": "AI4U Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "AI4U",
      "properties": {
        "ai4u.learningGates.useBackend": {
        "type": "boolean",
        "default": false,
        "description": "Use backend server for learning gates instead of local processing"
      },
        "ai4u.backendUrl": {
          "type": "string",
          "default": "http://localhost:8000",
          "description": "Backend server URL for AI4U (e.g., http://your-ec2-instance.com:8000)"
        },
        "ai4u.useBackend": {
          "type": "boolean",
          "default": false,
          "description": "Use backend server instead of local OpenAI API calls"
        },
        "ai4u.timeout": {
          "type": "number",
          "default": 30000,
          "description": "Request timeout in milliseconds"
        },
        "ai4u.learningGates.enabled": {
          "type": "boolean",
          "default": true,
          "description": "Enable learning gates - quiz questions before AI responses"
        },
        "ai4u.learningGates.frequency": {
          "type": "number",
          "default": 3,
          "description": "Show quiz every N messages (1-10)"
        },
        "ai4u.learningGates.difficulty": {
          "type": "string",
          "enum": ["easy", "medium", "hard", "mixed"],
          "default": "mixed",
          "description": "Difficulty level of quiz questions"
        },
        "ai4u.learningGates.responsesPerQuiz": {
          "type": "number",
          "default": 5,
          "description": "Number of AI responses unlocked per correct answer (1-10)"
        },
        "ai4u.learningGates.topics": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": ["JavaScript", "TypeScript", "Python", "React", "Algorithms", "Data Structures"],
          "description": "Topics for quiz questions"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/vscode": "^1.74.0",
    "@types/node": "16.x",
    "@types/node-fetch": "^2.6.2",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "openai": "^4.0.0",
    "node-fetch": "^2.6.7"
  }
}