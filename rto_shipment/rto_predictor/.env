# RTO Prediction System - Environment Variables
# Copy this file to .env and update with your values

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
POSTGRES_DB=rto_predictions
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=5432

# Full database URL (alternative to individual settings)
# DATABASE_URL=postgresql://postgres:postgres@postgres:5432/rto_predictions

# =============================================================================
# API CONFIGURATION
# =============================================================================
API_PORT=8000
API_HOST=0.0.0.0
LOG_LEVEL=INFO

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
# Model path
MODEL_PATH=models/rto_model.pkl

# Enable/disable features
ENABLE_SWAGGER=true
ENABLE_CORS=true

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:4200,http://localhost:3000

# =============================================================================
# PGADMIN (Optional - for database management)
# =============================================================================
PGADMIN_EMAIL=admin@rto.local
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# =============================================================================
# PRODUCTION SETTINGS (Uncomment for production)
# =============================================================================
# POSTGRES_PASSWORD=<strong-password>
# API_SECRET_KEY=<random-secret-key>
# LOG_LEVEL=WARNING
# ENABLE_SWAGGER=false

# =============================================================================
# TRAINING SETTINGS (Optional)
# =============================================================================
# TRAINING_DATA_PATH=data/training_data.csv
# MODEL_BACKUP_DIR=backups/
# MAX_BACKUPS=10

# =============================================================================
# PERFORMANCE SETTINGS (Optional)
# =============================================================================
# WORKERS=4
# MAX_CONNECTIONS=20
# POOL_SIZE=10
# POOL_OVERFLOW=20

# =============================================================================
# MONITORING (Optional)
# =============================================================================
# SENTRY_DSN=https://your-sentry-dsn
# PROMETHEUS_PORT=9090
