// Plugin structure for IntelliJ IDEA, PyCharm, WebStorm, etc.
// plugin.xml
<idea-plugin>
  <id>com.codewise.intellij</id>
  <name>CodeWise</name>
  <version>1.0</version>
  <vendor>CodeWise</vendor>
  
  <description>Educational code generator with learning gates</description>
  
  <depends>com.intellij.modules.platform</depends>
  <depends>com.intellij.modules.lang</depends>
  
  <extensions defaultExtensionNs="com.intellij">
    <toolWindow id="CodeWise" 
                secondary="true" 
                anchor="right" 
                factoryClass="com.codewise.toolwindow.CodeWiseToolWindowFactory"/>
    
    <applicationService serviceImplementation="com.codewise.services.CodeWiseService"/>
    
    <intentionAction>
      <className>com.codewise.intentions.GenerateCodeIntention</className>
    </intentionAction>
  </extensions>
  
  <actions>
    <action id="CodeWise.GenerateCode" 
            class="com.codewise.actions.GenerateCodeAction" 
            text="Generate Code with CodeWise">
      <add-to-group group-id="EditorPopupMenu" anchor="first"/>
      <keyboard-shortcut keymap="$default" first-keystroke="ctrl alt G"/>
    </action>
  </actions>
</idea-plugin>