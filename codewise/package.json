{
  "name": "codewise",
  "displayName": "CodeWise - Learning Assistant",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.74.0"
  },
  "categories": [
    "Education",
    "Other"
  ],
  "activationEvents": [
    "*"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codewise.helloWorld",
        "title": "Hello World",
        "category": "CodeWise"
      },
      {
        "command": "codewise.openChat",
        "title": "Open Chat",
        "category": "CodeWise"
      },
      {
        "command": "codewise.showContext",
        "title": "Show File Context",
        "category": "CodeWise"
      },
      {
        "command": "codewise.debugViews",
        "title": "Debug Views",
        "category": "CodeWise Debug"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codewise-sidebar",
          "title": "CodeWise",
          "icon": "$(mortar-board)"
        }
      ]
    },
    "views": {
      "codewise-sidebar": [
        {
          "id": "codewise-chat",
          "name": "Chat Assistant",
          "when": "true",
          "icon": "$(chat)"
        }
      ]
    }
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "16.x",
    "@types/vscode": "^1.74.0",
    "typescript": "^4.9.4"
  },
  "dependencies": {
    "axios": "^1.6.0"
  }
}