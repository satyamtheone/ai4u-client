# Production Environment Configuration

# API Configuration
# IMPORTANT: Update these URLs for your production environment
REACT_APP_BACKEND_URL=https://api.ai4u.com
REACT_APP_API_BASE_URL=https://api.ai4u.com/api/v1
REACT_APP_WS_URL=wss://api.ai4u.com/ws

# API Timeout Configuration (milliseconds)
REACT_APP_API_TIMEOUT=30000
REACT_APP_CONNECTION_TIMEOUT=5000
REACT_APP_CHAT_TIMEOUT=30000
REACT_APP_QUIZ_TIMEOUT=10000
REACT_APP_BATCH_TIMEOUT=15000

# Retry Configuration
REACT_APP_API_RETRIES=3
REACT_APP_RETRY_DELAY=1000
REACT_APP_RETRYABLE_STATUS_CODES=408,429,500,502,503,504

# Rate Limiting
REACT_APP_RATE_LIMIT_ENABLED=true
REACT_APP_RATE_LIMIT_MAX_REQUESTS=100
REACT_APP_RATE_LIMIT_WINDOW=60000

# Cache Configuration
REACT_APP_CACHE_ENABLED=true
REACT_APP_CACHE_TTL=300000
REACT_APP_CACHE_MAX_ENTRIES=100

# WebSocket Configuration
REACT_APP_WS_RECONNECT_INTERVAL=5000
REACT_APP_WS_MAX_RECONNECT_ATTEMPTS=5

# Pagination Configuration
REACT_APP_PAGINATION_DEFAULT=20
REACT_APP_PAGINATION_MAX=100

# React Query Configuration
REACT_APP_QUERY_STALE_TIME=300000
REACT_APP_QUERY_RETRY=1

# Storage Keys
REACT_APP_AUTH_TOKEN_KEY=authToken
REACT_APP_REFRESH_TOKEN_KEY=refreshToken
REACT_APP_CONFIG_KEY=ai4u_config

# Feature Flags (Production)
REACT_APP_FEATURE_LEARNING_GATES=true
REACT_APP_ENABLE_GOOGLE_AUTH=true
REACT_APP_ENABLE_ORGANIZATION_SIGNUP=true
REACT_APP_ENABLE_EMAIL_VERIFICATION=true
REACT_APP_ENABLE_TWO_FACTOR_AUTH=true
REACT_APP_ENABLE_DARK_MODE=true

# Production Settings
REACT_APP_DEBUG_MODE=false
REACT_APP_MOCK_API=false
REACT_APP_LOG_LEVEL=error

# Security Settings (Production)
REACT_APP_ENABLE_HTTPS_ONLY=true
REACT_APP_COOKIE_SECURE=true
REACT_APP_COOKIE_SAME_SITE=strict

# Analytics & Monitoring (Production)
# Add your actual keys here
REACT_APP_GOOGLE_ANALYTICS_ID=
REACT_APP_SENTRY_DSN=
REACT_APP_HOTJAR_ID=
