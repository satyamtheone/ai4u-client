# Environment Configuration for AI4U Multi-Tenancy

# Application Settings
REACT_APP_APP_NAME=AI4U
REACT_APP_APP_VERSION=1.0.0
NODE_ENV=development

# API Configuration
# Backend base URL (without /api/v1) - Change this for different environments
REACT_APP_BACKEND_URL=http://localhost:8001
# API base URL (with /api/v1) - Change this for different environments
REACT_APP_API_BASE_URL=http://localhost:8001/api/v1
# WebSocket URL - Change this for different environments
REACT_APP_WS_URL=ws://localhost:8001/ws

# Proxy Configuration - Set to 'true' to bypass CORS during development
# When true: Requests go through React dev server proxy (no CORS issues)
# When false: Direct requests to backend (requires backend CORS configuration)
REACT_APP_USE_PROXY=false

# Authentication
REACT_APP_JWT_SECRET=your-jwt-secret-key-here
REACT_APP_JWT_EXPIRES_IN=24h
REACT_APP_REFRESH_TOKEN_EXPIRES_IN=7d

# Google OAuth Configuration
REACT_APP_GOOGLE_CLIENT_ID=your-google-client-id
REACT_APP_GOOGLE_CLIENT_SECRET=your-google-client-secret
REACT_APP_GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback

# Database Configuration (for backend reference)
DATABASE_URL=postgresql://username:password@localhost:5432/ai4u_db
REDIS_URL=redis://localhost:6379

# File Upload Configuration
REACT_APP_MAX_FILE_SIZE=10485760
REACT_APP_ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Email Configuration (for backend)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
FROM_EMAIL=noreply@ai4u.com

# Analytics & Monitoring
REACT_APP_GOOGLE_ANALYTICS_ID=GA-XXXXXXXXX
REACT_APP_SENTRY_DSN=your-sentry-dsn
REACT_APP_HOTJAR_ID=your-hotjar-id

# Feature Flags
REACT_APP_ENABLE_GOOGLE_AUTH=true
REACT_APP_ENABLE_ORGANIZATION_SIGNUP=true
REACT_APP_ENABLE_EMAIL_VERIFICATION=true
REACT_APP_ENABLE_TWO_FACTOR_AUTH=false
REACT_APP_ENABLE_DARK_MODE=true
REACT_APP_FEATURE_LEARNING_GATES=false

# API Timeout (milliseconds)
REACT_APP_API_TIMEOUT=30000

# Rate Limiting
REACT_APP_RATE_LIMIT_MAX_REQUESTS=100
REACT_APP_RATE_LIMIT_WINDOW_MS=60000

# Cache Configuration
REACT_APP_CACHE_TTL=300000
REACT_APP_ENABLE_API_CACHE=true

# Development Settings
REACT_APP_DEBUG_MODE=true
REACT_APP_MOCK_API=false
REACT_APP_LOG_LEVEL=debug

# Security Settings
REACT_APP_ENABLE_HTTPS_ONLY=false
REACT_APP_COOKIE_SECURE=false
REACT_APP_COOKIE_SAME_SITE=lax

# Internationalization
REACT_APP_DEFAULT_LANGUAGE=en
REACT_APP_SUPPORTED_LANGUAGES=en,es,fr,de

# Third-party Integrations
REACT_APP_STRIPE_PUBLISHABLE_KEY=pk_test_your-stripe-key
REACT_APP_SLACK_CLIENT_ID=your-slack-client-id
REACT_APP_TEAMS_CLIENT_ID=your-teams-client-id

# Notification Settings
REACT_APP_PUSH_VAPID_PUBLIC_KEY=your-vapid-public-key
REACT_APP_ENABLE_PUSH_NOTIFICATIONS=true

# Performance & Optimization
REACT_APP_ENABLE_SERVICE_WORKER=true
REACT_APP_BUNDLE_ANALYZER=false
REACT_APP_PRELOAD_ROUTES=true

# Testing Configuration
REACT_APP_TEST_API_BASE_URL=http://localhost:8001/api/v1
REACT_APP_E2E_BASE_URL=http://localhost:3000